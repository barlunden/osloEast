---
const year = new Date().getFullYear();
---
<footer
  class="bg-gradient-to-br from-oebl-900 via-oebl-800 to-oebl-600 py-8"
>

  <div class="container mx-auto text-center text-white">
    <span class="text-oebl-200">Org.nr: 930 735 841</span>
    <address class="not-italic text-oebl-100 mb-2">
      E-post: <a href="mailto:kontakt@osloeastwindensemble.no" class="underline text-oebl-50 transition-colors hover:text-oebl-100">kontakt@osloeastwindensemble.no</a>
    </address>
  </div>
</footer>
<div class="relative z-10 bg-gradient-to-tr from-oebl-900/95 via-oebl-800/95 to-oebl-600/95 border-t-2 border-oebl-950 p-4 pb-6 text-center">
  <p class="text-md font-semibold text-oebl-200">
    &copy; {year} Oslo Øst Blåseensemble
  </p>
  <p class="text-xs text-oebl-100 mt-2">
    Nettside av <a
      href="https://cominoweb.no"
      class="underline hover:text-oebl-200 font-semibold">Comino Web AS</a>
  </p>
  <p class="text-xs text-oebl-300">
    <a href="https://www.pexels.com/video/people-on-the-band-playing-a-music-5257718/" target="_blank" class="underline hover:text-oebl-100">Header video av Kelly</a>
  </p>
</div>