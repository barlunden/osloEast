---
// Astro-komponent for Navbar uten React
const navLinks = [
  { href: '#hero', label: 'Hjem' },
  { href: '#about', label: 'Om oss' },
  { href: '#contact', label: 'Kontakt' }
];
---
<header class="sticky top-0 z-50 transition-all duration-300 bg-oeg-100 text-oeb-950 shadow">
  <nav class="container mx-auto flex flex-col sm:flex-row justify-between items-center py-2 sm:py-4 px-2 sm:px-0">
    <div class="font-bold text-lg sm:text-xl text-oeb-950 mb-2 sm:mb-0">Oslo East Wind Ensemble</div>
    <ul class="flex flex-col sm:flex-row gap-2 sm:gap-6 w-full sm:w-auto text-base sm:text-lg">
      {navLinks.map(link => (
        <li><a href={link.href} class="hover:text-oer-800 text-oeb-950">{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
