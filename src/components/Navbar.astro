---
// src/components/Navbar.astro
const navLinks = [
  { href: '#hero', label: 'Hjem' },
  { href: '#about', label: 'Om oss' },
  { href: '#contact', label: 'Kontakt' }
];
---
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-oebl-100 shadow-sm">
  <nav class="container mx-auto flex items-center justify-between py-4 px-4 sm:px-6">
    
    <div class="font-black text-xl sm:text-2xl text-oebl-950 tracking-tighter z-50">
      OSLO ØST <span class="text-oer-600">BLÅSEENSEMBLE</span>
    </div>

    <button
      id="hamburger-btn"
      class="sm:hidden p-2 rounded-xl bg-oebl-50 text-oebl-950 focus:outline-none z-50 transition-colors hover:bg-oebl-100"
      aria-label="Åpne meny"
      aria-expanded="false"
    >
      <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <ul 
      id="nav-menu"
      class="
        flex flex-col sm:flex-row gap-0 sm:gap-8
        absolute sm:static left-0 right-0 top-full 
        bg-white sm:bg-transparent shadow-2xl sm:shadow-none
        transition-all duration-300 ease-in-out
        max-h-0 sm:max-h-none overflow-hidden sm:overflow-visible
        px-6 sm:px-0 rounded-b-3xl sm:rounded-none
      "
    >
      {navLinks.map(link => (
        <li>
          <a 
            href={link.href} 
            class="block py-5 sm:py-2 text-oebl-900 font-bold text-lg sm:text-sm uppercase tracking-widest hover:text-oer-600 transition-colors border-b border-oebl-50 sm:border-none"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script>
    const btn = document.getElementById('hamburger-btn');
    const menu = document.getElementById('nav-menu');
    
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        menu.classList.toggle('max-h-0');
        menu.classList.toggle('max-h-[400px]'); // Litt raus høgde
        btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      });

      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('max-h-0');
          menu.classList.remove('max-h-[400px]');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</header>