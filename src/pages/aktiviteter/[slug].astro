---
// src/pages/dirigent/[slug].astro
import Layout from "../../layout/Layout.astro";

export async function getStaticPaths(): Promise<{ params: { slug: string }, props: { profil: any } }[]> {
  const profiler = await Astro.glob("../../content/aktiviteter/*.md");
  return profiler.map(profil => ({
    params: { slug: profil.file ? profil.file.split('/').pop()?.split('.')[0] ?? "" : "" },
    props: { profil },
  }));
}

const { profil } = Astro.props;
const { Content } = profil;
const { title } = profil.frontmatter;
---

<Layout title={title}>
  <article class="max-w-2xl mx-auto py-20 px-4 prose prose-lg">
    <h1 class="pt-10">{title}</h1>
    <Content />
    <a href="/">← Tilbake til fremsiden</a>
  </article>
</Layout>