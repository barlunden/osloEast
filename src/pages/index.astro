---
import Layout from "../layout/Layout.astro";
import Hero from "../components/Hero.astro";
import DirigentProfil from "../components/DirigentProfil.astro";
import Calendar from "../components/Calendar.jsx";
import ContactForm from "../components/ContactForm.astro";

// Import av innhald
import * as barlund from "../content/barlund.md";
import * as svestad from "../content/svestad.md";

const profiler = [svestad, barlund];
---

<Layout title="Oslo Øst Blåseensemble">
  
  <Hero />

  <section id="about" class="py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-oebl-900 text-3xl sm:text-5xl font-black mb-10 border-l-8 border-oer-600 pl-6 tracking-tight">
          Om oss
        </h2>
        <div class="prose prose-lg prose-oebl max-w-none">
          <p>
            Velkommen til Oslo Øst Blåseensemble sine nettsider.
          </p>
          <p>
            Oslo Øst Blåseensemble samler unge musikanter fra 13–19 år, fra Oslo øst
            og nærområdene. Ensemblet fungerer som et springbrett i overgangen fra
            skolekorps til voksenliv som musiker.
          </p>
          <p>
            Vi gir ungdom med musikkinteresse en unik mulighet til å utvikle seg
            videre, og til å bygge bro mellom oppvekst i skolekorps og et liv med
            musikk som ung voksen. Oslo Øst Blåseensemble er et supplement til
            skolekorpsene: Vi tilbyr et inspirerende miljø og nye musikalske
            utfordringer utover det vanlige korpslivet i tenårene.
          </p>
          <p>
            Gjennom vårt tilbud ønsker vi også å styrke skolekorpsene i området,
            både faglig og i rekrutteringen, slik at de får enda bedre vilkår for å
            gi barn og unge gode musikkopplevelser på både kort og lang sikt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="dirigenter" class="py-24 bg-oeg-50">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-black text-oebl-900 mb-12 text-center tracking-tight">
          Våre dirigenter
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {profiler.map((profil) => (
            <DirigentProfil profil={profil} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <Calendar client:visible />

  <ContactForm />

</Layout>